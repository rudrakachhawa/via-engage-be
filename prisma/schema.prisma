generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {

  id String @id @default(cuid())

  email  String  @unique
  name   String?
  avatar String?
  igUserId     String?  @unique
  firebaseUuid String @unique

  instaUser  InstaUser?
  instaOauth InstaOauth?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstaUser {
  userId   String @id
  igUserId String @unique
  scope    String
  userName String
  name     String
  avatar   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InstaOauth {
  userId      String @id
  igUserId    String
  accessToken String
  expires_in  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}