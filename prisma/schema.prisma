generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  avatar       String?
  firebaseUuid String  @unique

  instaAccounts      InstaAccount[]
  instaAccountOauths InstaAccountOauth[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstaAccount {
  id       String @id @default(cuid())
  userId   String
  igUserId String @unique
  scope    String
  userName String
  name     String
  avatar   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  automations Automation[]
  events      MetaEvents[]
}

model InstaAccountOauth {
  id          String @id @default(cuid())
  userId      String
  igUserId    String @unique
  accessToken String
  expires_in  Int
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Automation {
  id           String        @id @default(cuid())
  userId       String?
  igUserId     String?
  instaAccount InstaAccount? @relation(fields: [igUserId], references: [igUserId], onDelete: Cascade)

  name               String
  description        String?
  messageTemplate    String?
  triggerType        TriggerType?
  keywords           String[]     @default([])

  commentReplies     String[]     @default(["Check your DM"])

  targetContentId    String?
  targetContentType  ContentType?
  targetContentUrl   String?
  targetThumbnailUrl String?

  isActive Boolean @default(false)

  events MetaEvents[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MetaEvents {
  id           String       @id @default(cuid())
  igUserId     String
  instaAccount InstaAccount @relation(fields: [igUserId], references: [igUserId], onDelete: Cascade)

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  triggerType       TriggerType
  recipientIgId     String
  recipientUsername String?
  commentId         String?
  mediaId           String?
  commentText       String?
  rawPayload        Json?

  status   EventStatus @default(PENDING)
  priority Int         @default(2)

  scheduledFor DateTime?
  expiresAt   DateTime?

  attempts        Int       @default(0)
  lastAttemptedAt DateTime?
  errorLog        String?
  dedupeKey String? @unique
  jobId String?
  processedAt DateTime?

  createdAt DateTime @default(now())
}

enum TriggerType {
  COMMENT
  DM
  LIVE_COMMENT
  STORY_REPLY
  MENTION
}

enum ContentType {
  POST
  REEL
  STORY
}

enum EventStatus {
  PENDING
  PROCESSING
  DM_SENT
  COMMENT_REPLIED
  FAILED
  EXPIRED
  COMPLETED
}