generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  avatar       String?
  firebaseUuid String  @unique

  instaAccounts      InstaAccount[]
  instaAccountOauths InstaAccountOauth[]  // ← array

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstaAccount {
  id       String @id @default(cuid())
  userId   String
  igUserId String @unique
  scope    String
  userName String
  name     String
  avatar   String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  automations Automation[]
  events      EventQueue[]
}

model InstaAccountOauth {
  id          String @id @default(cuid())  // ← surrogate PK
  userId      String
  igUserId    String @unique               // ← one token per IG account
  accessToken String
  expires_in  Int
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Automation {
  id           String       @id @default(cuid())
  userId       String?
  igUserId     String?
  instaAccount InstaAccount? @relation(fields: [igUserId], references: [igUserId], onDelete: Cascade)

  name               String
  description        String?
  messageTemplate    String?
  triggerType        TriggerType?
  keywords           String[]     @default([])

  targetContentId    String?
  targetContentType  ContentType?
  targetContentUrl   String?
  targetThumbnailUrl String?

  isActive Boolean @default(false)

  replies AutomationReply[]
  events  EventQueue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AutomationReply {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  message String
  order   Int    @default(0)

  createdAt DateTime @default(now())
}

model EventQueue {
  id           String       @id @default(cuid())
  igUserId     String
  instaAccount InstaAccount @relation(fields: [igUserId], references: [igUserId], onDelete: Cascade)

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  triggerType       TriggerType
  recipientIgId     String
  recipientUsername String?
  commentId         String?
  mediaId           String?
  commentText       String?
  rawPayload        Json

  status   EventStatus @default(PENDING)
  priority Int         @default(2)

  triggeredAt DateTime
  expiresAt   DateTime

  attempts        Int       @default(0)
  lastAttemptedAt DateTime?
  errorLog        String?

  createdAt DateTime @default(now())

  @@index([status, priority, triggeredAt])
  @@index([igUserId, status])
}

enum TriggerType {
  COMMENT
  DM
  LIVE_COMMENT
  STORY_REPLY
  MENTION
}

enum ContentType {
  POST
  REEL
  STORY
}

enum EventStatus {
  PENDING
  PROCESSING
  DM_SENT
  COMMENT_REPLIED
  FAILED
  EXPIRED
}