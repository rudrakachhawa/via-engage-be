{
  "name": "via-engage-be",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch . --ext ts,js,json --exec tsx ./bin/www.ts",
    "start": "tsx ./bin/www.ts",
    "build": "tsc",
    "worker": "tsx workers/outbound.worker.ts",
    "start:all": "prisma generate && concurrently \"node dist/bin/www.js\" \"node dist/workers/outbound.worker.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.16.0",
    "bullmq": "^5.77.6",
    "concurrently": "^10.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "~4.16.1",
    "firebase-admin": "^13.9.0",
    "http-errors": "~1.6.3",
    "ioredis": "^5.11.0",
    "jade": "~1.11.0",
    "mongoose": "^9.6.2",
    "morgan": "~1.9.1",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.2",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "bullmq": {
      "ioredis": "$ioredis"
    }
  }
}
